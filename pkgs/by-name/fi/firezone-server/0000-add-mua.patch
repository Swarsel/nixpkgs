diff --git a/config/runtime.exs b/config/runtime.exs
index 2d7d41777..7840dc9ed 100644
--- a/config/runtime.exs
+++ b/config/runtime.exs
@@ -782,12 +782,29 @@ if config_env() == :prod do
     config :req, default_options: [plugins: []]
   end
 
+  # The Mua adapter is configured via dedicated environment variables, so the
+  # SMTP password doesn't have to be embedded into OUTBOUND_EMAIL_ADAPTER_OPTS.
+  outbound_email_smtp_opts =
+    if env_var_to_config!(:outbound_email_adapter) == Swoosh.Adapters.Mua do
+      [
+        protocol: String.to_atom(System.fetch_env!("OUTBOUND_EMAIL_SMTP_PROTOCOL")),
+        relay: System.fetch_env!("OUTBOUND_EMAIL_SMTP_HOST"),
+        port: String.to_integer(System.fetch_env!("OUTBOUND_EMAIL_SMTP_PORT")),
+        auth: [
+          username: System.fetch_env!("OUTBOUND_EMAIL_SMTP_USERNAME"),
+          password: System.fetch_env!("OUTBOUND_EMAIL_SMTP_PASSWORD")
+        ]
+      ]
+    else
+      []
+    end
+
   config :portal,
          Portal.Mailer,
          [
            adapter: env_var_to_config!(:outbound_email_adapter),
            from_email: env_var_to_config!(:outbound_email_from)
-         ] ++ env_var_to_config!(:outbound_email_adapter_opts)
+         ] ++ outbound_email_smtp_opts ++ env_var_to_config!(:outbound_email_adapter_opts)
 
   config :portal,
          Portal.Mailer.Secondary,
